AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=DUMMYIDEXAMPLE
AWS_SECRET_ACCESS_KEY=DUMMYSECRETANDKEYEXAMPLE
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
USERS_TABLE=mundial-ko-local-users
BRACKETS_TABLE=mundial-ko-local-brackets
MATCHES_TABLE=mundial-ko-local-matches
ENVIRONMENT=local
# docker-compose overrides REDIS_ENDPOINT to "valkey" via the api service environment block.
# When running the backend outside Docker (e.g. directly with uvicorn), keep REDIS_ENDPOINT=localhost.
REDIS_ENDPOINT=localhost
REDIS_PORT=6379
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
JWT_ISSUER=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/soccer/fifa.world
