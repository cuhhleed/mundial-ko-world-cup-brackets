# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

region               = "us-east-1"
environment          = "dev"
project_name         = "mundial-ko"
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
container_port       = 8000

# ECS API scaling
desired_count = 2

# ElastiCache Valkey
valkey_node_type          = "cache.t4g.medium"
valkey_num_cache_clusters = 2
valkey_multi_az           = true
valkey_automatic_failover = true
valkey_apply_immediately  = true
